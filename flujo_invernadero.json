  {
    "id": "decide",
    "type": "function",
    "z": "tab1",
    "name": "Evaluar lectura",
    "func": "const d = (typeof msg.payload === \"string\") ? JSON.parse(msg.payload) : msg.payload;\nconst alerta = d.humedad_suelo < 30 ? 1 : 0;\nconst db = { params: {\n    $fecha: d.fecha || new Date().toISOString(),\n    $temperatura: d.temperatura,\n    $humedad_suelo: d.humedad_suelo,\n    $alerta: alerta\n}};\nconst temp = { payload: d.temperatura, topic: \"Temperatura\" };\nconst suelo = { payload: d.humedad_suelo, topic: \"Humedad del suelo\" };\nconst txt = { payload: alerta ? \"ALERTA: suelo seco (\" + d.humedad_suelo + \"%) - regando\" : \"Todo normal\" };\nconst cmd = alerta ? { payload: \"REGAR\", topic: \"invernadero/comando\" } : null;\nreturn [db, temp, suelo, txt, cmd];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 240,
    "wires": [
      [
        "insert"
      ],
      [
        "gtemp",
        "ctemp"
      ],
      [
        "gsuelo",
        "csuelo"
      ],
      [
        "utxt"
      ],
      [
        "mqout"
      ]
    ]
  },
