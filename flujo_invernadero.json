    "type": "mqtt in",
    "z": "tab1",
    "name": "invernadero/sensor",
    "topic": "invernadero/sensor",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "cfgmqtt",
    "nl": false,
    "rap": true,
